{
  "name": "play-it-forward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server shared tests scripts vite.config.ts",
    "bark:smoke": "tsx scripts/bark-smoke.ts",
    "bark:create-wallet": "tsx scripts/create-wallet.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "bitcoinjs-lib": "7.0.0",
    "bolt11": "1.4.1",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  },
  "packageManager": "pnpm@11.19.0"
}
