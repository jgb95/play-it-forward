[Unit]
Description=Organizer Bark wallet (local API only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=playforward
Group=playforward
ExecStart=/usr/local/bin/barkd-0.7.1 --datadir /var/lib/play-it-forward/bark-mainnet --host 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/play-it-forward

[Install]
WantedBy=multi-user.target
